    "PayIDDomainsObj": {
      "type": "array",
      "description": "A list of domain names that can be use for payIDs. Optionally use `merchantName` to control the payID\ndescription prefix.\n",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "description": "The domain name for the PayID",
            "pattern": "^\\b((?=[a-z0-9-]{1,63}\\.)[a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z]{2,63}\\b$"
          },
          "merchantName": {
            "type": "string",
            "description": "This name will appear as a prefix for the PayID description that the payer sees",
